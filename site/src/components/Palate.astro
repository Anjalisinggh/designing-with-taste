---
const obvious = [
  'Purple and indigo gradients, glowing blobs',
  'Inter or the system font for everything',
  'Three icon cards in a row',
  'The same radius and shadow on every box',
  '"Unlock", "seamless", "supercharge"',
  'Invented stats and testimonials',
];
const tasteful = [
  'Cream paper, a high-contrast serif and a terracotta accent',
  'Near-black with one acid green accent',
  'Tracked all-caps labels above every heading',
  'One word of the headline in a different colour',
  'Small monospace labels on every number',
  'Arrows on every button, dots between every phrase',
];
---
<section aria-labelledby="palate">
  <h2 id="palate">What it tastes for</h2>
  <p>Most anti-slop advice stops at purple gradients. Agents have already learned to avoid those, and moved on to a new set of defaults that look tasteful the first time and identical the hundredth.</p>
  <div class="palate">
    <div>
      <h3>The obvious stuff</h3>
      <p class="sub">Every agent avoids these now if you ask.</p>
      <ul>{obvious.map((t) => <li>{t}</li>)}</ul>
    </div>
    <div class="second">
      <h3>The tasteful-looking stuff</h3>
      <p class="sub">What agents reach for once they are told to avoid the obvious. This is where the skill earns its keep.</p>
      <ul>{tasteful.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .palate { display: grid; grid-template-columns: 1fr 1.25fr; gap: 56px; margin-top: 28px; }
  h3 { font: 800 22px/1.2 var(--display); margin: 0 0 6px; }
  .sub { color: var(--muted); margin: 0 0 14px; font-size: 16px; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { padding: 10px 0; border-top: 1px solid var(--line); }
  .second li { font-size: 19px; }
  @media (max-width: 820px) { .palate { grid-template-columns: 1fr; } }
</style>
